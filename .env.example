# Copy this file to .env to override defaults. Local generation needs no API key.
# Never commit .env.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b-instruct
LLM_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT=180
LLM_CONTEXT_TOKENS=32768
LLM_MAX_TOKENS=32

# Another Ollama model requires its matching tokenizer and immutable revision:
# LLM_TOKENIZER=organization/model
# LLM_TOKENIZER_REVISION=40-character-Hugging-Face-commit-SHA

# Optional Gemini: install requirements-gemini.txt and change LLM_PROVIDER/LLM_MODEL.
# GOOGLE_API_KEY=
